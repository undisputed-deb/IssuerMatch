# Fake values. Copy to .env and fill in real ones. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_DB_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_JWKS_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Frontend only (anon key is public by design)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Present in .env but NOT used by this project
SUPABASE_SECRET_KEY=unused
