# Fake values. Copy to .env and fill in real ones. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_DB_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_JWKS_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Frontend only (anon key is public by design)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server side only: lets POST /auth/signup create users. Never expose it to the frontend, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Older name for the same kind of key; used only if SUPABASE_SERVICE_ROLE_KEY is not set
SUPABASE_SECRET_KEY=
